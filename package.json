{
  "name": "backend-challenge-jungle-gaming",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor - Jungle Gaming technical challenge",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "bun run src/main.ts",
    "build": "nest build",
    "migrate:create": "mikro-orm migration:create",
    "migrate:up": "bun run src/infrastructure/persistence/mikro-orm/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/persistence/mikro-orm/migrate.ts down",
    "migrate:fresh": "bun run src/infrastructure/persistence/mikro-orm/migrate.ts fresh",
    "test": "bun test",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load/load.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.658.0",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/nestjs": "^6.1.2",
    "@mikro-orm/postgresql": "^6.4.0",
    "@mikro-orm/reflection": "^6.4.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js-light": "^2.5.1",
    "pg": "^8.16.0",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@nestjs/cli": "^11.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "~5.8.0"
  },
  "bun": {
    "test": {
      "timeout": 60000
    }
  }
}