# Ambiente
NODE_ENV=development
PORT=3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=jungle
PGPASSWORD=jungle
PGDATABASE=jungle_gaming

# SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_CONSUMER_NAME=wager-transaction-consumer

# Background workers (comma-separated; empty = API only, all = every loop)
# Roles: sqs-consumer,outbox,pending-references,metrics-snapshot
WORKER_ROLES=all
PENDING_REFERENCE_POLL_INTERVAL_MS=60000

# Outbox
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_MAX_ATTEMPTS=10

# Durable metrics snapshots
METRICS_INSTANCE_ID=local
METRICS_SNAPSHOT_INTERVAL_MS=60000

# Logger
LOG_LEVEL=info
